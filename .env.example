# ----------------------------------------------------------------------------
# SECRETS TEMPLATE
#
# 1. Make a copy of this file and name the copy ".env"  (just .env, nothing else)
# 2. Put your real keys/passwords in the .env copy — NOT in this file.
# 3. The .env file is kept private and is never shared or uploaded.
#
# This .env.example file only lists the NAMES of the secrets your agent needs,
# so other people know what to fill in. It must never contain real values.
# ----------------------------------------------------------------------------

# Add the secrets your agent needs below, one per line, like:
# EXAMPLE_API_KEY=your_key_here
# SERVICE_EMAIL=you@example.com
# SERVICE_PASSWORD=your_password_here

# ---- Metabase (read-only SQL access to the MySQL read replica) ----
# http, not https. Auth is session login (this Metabase has no API keys).
METABASE_URL=http://metabase.internal.crio.do
METABASE_USER=your_metabase_email_here
METABASE_PASSWORD=your_metabase_password_here
# Database 69 = "sql-prod-new" -> mysql-read-replica.prod.crio.do:3306 / crio-database
METABASE_DB_ID=69
# TODO: before the pilot, swap to a dedicated read-only agent user instead of a personal login.

# LSQ REST API (read-only client: tools/lsq_client.py). Account-owner keys - attended use only.
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_HOST=https://api-in21.leadsquared.com/v2/
LSQ_ACCOUNT=71599
